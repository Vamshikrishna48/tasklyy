{
  "rewrites": [
    {
      "source": "/api/verify-upi",
      "destination": "/api/verify-bank"
    },
    {
      "source": "/api/send-upi-rejection-email",
      "destination": "/api/send-deletion-email"
    },
    {
      "source": "/api/consultancy-auth",
      "destination": "/api/internship-auth"
    },
    {
      "source": "/api/create-razorpay-order",
      "destination": "/api/get-razorpay-key"
    },
    {
      "source": "/api/process-withdrawal",
      "destination": "/api/request-withdrawal"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
